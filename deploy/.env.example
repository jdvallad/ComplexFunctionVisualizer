# Copy this file to deploy/.env and fill in your values before running docker compose.

# Port exposed on your Unraid server
HOST_PORT=1738

# Public-safe default (recommended when exposed to the internet):
WITH_CLANG=0
CFV_ENABLE_COMPILE=0
CFV_COMPILE_TOKEN=

# Optional: To enable token-protected Live C Compilation from school, use:
#   WITH_CLANG=1
#   CFV_ENABLE_COMPILE=1
#   CFV_COMPILE_TOKEN=replace-with-a-long-random-secret
# And remove `,noexec` from the tmpfs /tmp line in docker-compose.yml so dlopen() works.

# Optional: Cloudflare Tunnel token (from Cloudflare Zero Trust -> Networks -> Tunnels)
# Then run: docker compose --profile tunnel up -d
CLOUDFLARE_TUNNEL_TOKEN=
