  "name": "Julia Origami: Holomorphic Fractal Folder",
  "subtitle": "2 cards · 4 presets",
  "mode": "map",
  "splitPct": 50,
  "cards": [
    {
      "title": "Quadratic Step Q(z) = z^2 + c",
      "code": "z * z + c_make(c_re, c_im)",
      "color": "#a78bfa",
      "lineWidth": 2.2,
      "lineStyle": "solid",
      "step": false,
      "locked": false,
      "visible": true,
      "active": false
    },
    {
      "title": "Continuous Holomorphic Iteration Q^(depth)(z)",
      "code": "double complex w = z;\ndouble d = depth;\nif (d < 0.0) d = 0.0;\nif (d > 4.0) d = 4.0;\nint steps = (int)floor(d);\ndouble frac = d - (double)steps;\nfor (int k = 0; k < steps; ++k) {\n    w = f1(w);\n    if (!c_isfinite(w) || cabs(w) > 1e6) return c_make(INFINITY, 0.0);\n}\nif (frac > 1e-9) {\n    double complex next_w = f1(w);\n    if (!c_isfinite(next_w) || cabs(next_w) > 1e6) return c_make(INFINITY, 0.0);\n    w = c_make(1.0 - frac, 0.0) * w + c_make(frac, 0.0) * next_w;\n}\nreturn w;",
      "color": "#38bdf8",
      "lineWidth": 2.2,
      "lineStyle": "solid",
      "step": false,
      "locked": false,
      "visible": true,
      "active": true
    }
  ],
  "sliders": [
    {
      "name": "depth",
      "label": "Fold Depth (Iterations)",
